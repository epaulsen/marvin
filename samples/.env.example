# Docker Hub-image som compose skal hente.
MARVIN_IMAGE=epaulsen/marvin:latest

# IP-adresse på serveren som porten bindes til; 0.0.0.0 betyr alle grensesnitt.
MARVIN_HOST_IP=0.0.0.0

# Port på serveren som Voice PE kobler til.
MARVIN_HOST_PORT=5678

# Intern HTTP-port i containeren.
MARVIN_CONTAINER_PORT=8080

# Aspire Dashboard er tilgjengelig uten innlogging på dette grensesnittet.
ASPIRE_DASHBOARD_HOST_IP=0.0.0.0
ASPIRE_DASHBOARD_PORT=18888

# ASP.NET Core-miljø; bruk Production på serveren.
ASPNETCORE_ENVIRONMENT=Production

# API-nøkkel for Opper-transkripsjon.
OPPER_API_KEY=

# API-nøkkel for OpenAI; uten nøkkel leses transkripsjonen tilbake.
OPENAI_API_KEY=

# OpenAI-modell for samtalesvar.
OPENAI_MODEL=gpt-6-luna

# Home Assistant-adresse tilgjengelig fra containeren, uten sti.
HOME_ASSISTANT_URL=http://homeassistant.local:8123

# Home Assistant long-lived access token for TTS og eventuell MCP.
HOME_ASSISTANT_TOKEN=

# Entity-ID for Home Assistants TTS-tjeneste.
HOME_ASSISTANT_TTS_ENTITY=tts.example

# Aktiver Home Assistant MCP og styring av enheter eksponert for Assist.
HOME_ASSISTANT_MCP_ENABLED=false

# Logg transkripsjoner; kan avsløre sensitivt innhold i loggene.
MARVIN_LOG_TRANSCRIPTS=false

# Generelt loggnivå.
LOG_LEVEL_DEFAULT=Information

# Loggnivå for Marvin.
LOG_LEVEL_MARVIN=Debug

# Loggnivå for ASP.NET Core.
LOG_LEVEL_ASPNETCORE=Warning

# Inkluder loggkontekst, som forbindelse og request-ID.
LOG_INCLUDE_SCOPES=true
